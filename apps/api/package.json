{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint src test integration-tests scripts vitest.integration.config.mts --ignore-pattern \"**/*.integration.js\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "migration:show": "pnpm run build && node scripts/verify-migration-history.mjs",
    "migration:run": "pnpm run build && node scripts/migration-run.mjs",
    "migration:revert": "pnpm run build && node scripts/verify-migration-history.mjs && typeorm migration:revert -d dist/database/data-source.js",
    "auth:bootstrap-admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
